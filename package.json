{
  "name": "stjudecloud-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "prepare": "husky",
    "postinstall": "nuxt prepare && husky",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.1",
    "@iconify-json/simple-icons": "^1.2.9",
    "@nuxt/content": "^2.13.4",
    "@nuxt/fonts": "^0.10.0",
    "@nuxt/icon": "^1.10.3",
    "@nuxt/image": "^1.8.1",
    "@nuxt/ui-pro": "^1.4.4",
    "nuxt": "^3.13.2",
    "nuxt-3-intercom": "^1.1.2",
    "nuxt-og-image": "^6.2.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.6.0",
    "@nuxthq/studio": "^2.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.7",
    "markdown-link-check": "3.12.2",
    "markdown-spellcheck": "^1.3.1",
    "markdown-table-formatter": "^1.6.1",
    "markdownlint-cli2": "^0.17.2",
    "semantic-release": "^24.2.1",
    "vue-tsc": "^2.1.6"
  },
  "release": {
    "branches": [
      "main"
    ],
    "preset": "conventionalcommits",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "perf",
              "release": "minor"
            },
            {
              "type": "revise",
              "release": "minor"
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features (New)"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "docs",
                "section": "Documentation Updates"
              },
              {
                "type": "style",
                "section": "Style Updates"
              },
              {
                "type": "refactor",
                "section": "Code Refactoring"
              },
              {
                "type": "revise",
                "section": "Features (Revisions)"
              },
              {
                "type": "perf",
                "section": "Performance Improvements"
              },
              {
                "type": "test",
                "section": "Test"
              },
              {
                "type": "ci",
                "section": "CI"
              }
            ]
          }
        }
      ],
      "@semantic-release/changelog",
      [
        "@semantic-release/git",
        {
          "message": "chore(release): ${nextRelease.gitTag}\n\n${nextRelease.notes}"
        }
      ],
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ],
      [
        "@semantic-release/exec",
        {
          "verifyReleaseCmd": "echo ${nextRelease.version} > .VERSION"
        }
      ]
    ]
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.33.4"
    },
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "packageManager": "pnpm@9.12.2"
}
