{
  "name": "stjudecloud-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "linkcheck": "markdown-link-check -c .mlc_config.json content/**/*.md",
    "lint": "eslint .",
    "markdownlint": "markdownlint content",
    "spellcheck": "mdspell --ignore-numbers --ignore-acronyms --en-us --no-suggestions --report content/**/*.md",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/heroicons": "^1.2.1",
    "@iconify-json/simple-icons": "^1.2.9",
    "@nuxt/content": "^2.13.4",
    "@nuxt/fonts": "^0.10.0",
    "@nuxt/icon": "^1.10.3",
    "@nuxt/image": "^1.8.1",
    "@nuxt/ui-pro": "^1.4.4",
    "nuxt": "^3.13.2",
    "nuxt-og-image": "^3.0.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.6.0",
    "@nuxthq/studio": "^2.1.1",
    "eslint": "^9.13.0",
    "markdown-link-check": "3.12.2",
    "markdown-spellcheck": "^1.3.1",
    "markdown-table-formatter": "^1.6.1",
    "markdownlint": "^0.37.4",
    "vue-tsc": "^2.1.6"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.33.4"
    },
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  },
  "packageManager": "pnpm@9.12.2"
}
